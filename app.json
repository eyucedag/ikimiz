{
  "expo": {
    "name": "\u0130kimiz",
    "slug": "ikimiz",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ikimiz",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ikimiz.mobile"
    },
    "android": {
      "package": "app.ikimiz.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF8F5"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Partnerinizin yönünü göstermek için uygulama açıkken konum paylaşılır." }
      ],
      [
        "expo-sensors",
        { "motionPermission": "İkimiz, birlikte olduğunuz sırada adım saymak için hareket verisine erişir." }
      ]
    ],
    "owner": "eyucedag",
    "extra": {
      "eas": {
        "projectId": "6d0fb1e3-3583-4131-8f52-2c356a4066cd"
      }
    }
  }
}

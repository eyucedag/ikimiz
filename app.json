{
  "expo": {
    "name": "İkimiz",
    "slug": "ikimiz",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ikimiz",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ikimiz.mobile"
    },
    "android": {
      "package": "app.ikimiz.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#082D25"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#082D25"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Galeriye fotoğraf eklemek için fotoğraf arşiviniz seçilir.",
          "savePhotosPermission": "Galerideki fotoğrafları telefon arşivinize kaydetmek için izin gerekir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Partnerinizin yönünü göstermek için uygulama açıkken konum paylaşılır."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "İkimiz, birlikte olduğunuz sırada adım saymak için hareket verisine erişir."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli anı kaydetmek için mikrofon izni gerekir.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "owner": "eyucedag",
    "extra": {
      "eas": {
        "projectId": "6d0fb1e3-3583-4131-8f52-2c356a4066cd"
      }
    }
  }
}
